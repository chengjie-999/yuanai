data/*
!data/aiprompt/
agent/data/

# OS
.DS_Store
Thumbs.db

# Environment
.env
*.env.local
# S5.1：生产环境配置不入库（模板见 deploy/.env.production.example，
# 填了真凭据的文件绝不能被 git 跟踪）
deploy/.env.production

# SSL certificates (keep .gitkeep only)
deploy/ssl/*
!deploy/ssl/.gitkeep

# Database
*.db
*.sqlite3

# Jupyter
.ipynb_checkpoints/

# Temp files
*.tmp

# PyInstaller build artifacts
build/
dist/
*.spec

# Virtual environments (besides venv/)
utils/excel_env/

# Large media files
*.mp4
*.avi
*.mkv
*.mov
*.wmv

# Excel/Office temp files
~$*.xlsx
~$*.docx

# Agent 安装包运行时产物（网页上传生成，不入库）
downloads/version.json
downloads/yuanai-agent.exe
downloads/*.uploading
