# 环境变量（通过 docker-compose env_file 注入）
.env
.env.*

# Python
__pycache__
*.py[cod]
*.egg-info
.eggs
.pytest_cache
*.egg

# Node
frontend/node_modules
frontend/dist

# IDE
.idea
.vscode
*.swp
*.swo

# Git（保留 .git 以支持代码监控）
.gitignore
.gitattributes

# 运行时数据（S3.2 M5：整目录排除 + 反白名单 aiprompt——
# agent_identity.json/models.json/claude_sessions.json/logs 等凭据文件绝不进镜像；
# 命名卷 app_data 挂载 /app/data，运行不受影响）
data/*
!data/aiprompt/
!data/aiprompt/**
web_cookie/*

# 文档
*.md
!CLAUDE.md

# 本地 Agent（云端 API 不需要）
agent/
skills/

# 构建产物
build/
dist/

# 虚拟环境
venv/

# 测试
test/

# 杂项
.DS_Store
*.log
