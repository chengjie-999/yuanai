FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV APP_HOME=/app

WORKDIR $APP_HOME

# apt 国内镜像加速（动态检测 Debian 版本）
RUN . /etc/os-release && \
    echo "deb http://mirrors.aliyun.com/debian $VERSION_CODENAME main contrib non-free non-free-firmware" > /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian $VERSION_CODENAME-updates main contrib non-free non-free-firmware" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian-security $VERSION_CODENAME-security main contrib non-free non-free-firmware" >> /etc/apt/sources.list

# 系统依赖：Playwright/Selenium 浏览器自动化需要的库
# apt 源换国内（2026-11-15 用户立规：以后下载都走国内镜像——debian 官方
# 源境外直连不稳；阿里云 debian 源，失败保留官方兜底）
RUN (sed -i 's#deb.debian.org#mirrors.aliyun.com#g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true)     && (sed -i 's#deb.debian.org#mirrors.aliyun.com#g' /etc/apt/sources.list 2>/dev/null || true)     && apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# pip 先升级（2026-11-16：python:3.10-slim 自带 pip 23.0.1 的旧 resolver
# 解析 214 个锁定包 + mcp/textual 新依赖回溯卡死 7.5 小时 exit 2——
# pip 26 新 resolver 秒级解析）
# 知识库向量检索暂关闭（2026-11-16 用户拍板「直接不用了」）——
# torch/sentence-transformers/transformers 不进服务器镜像（省 200MB+），
# 检索功能本地开发保留；rag.py 惰性加载，服务器启动不受影响
# 分层防全量重装（2026-11-16，用户立规「部署不要再出问题」）：大依赖冻结
# 第一层——requirements 易变部分（新增小包）改动时本层缓存命中，只有大包
# 版本变化才重装；剩余包排除大包后单层安装
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install -U "pip==26.1.1" && \
    pip install --no-cache-dir numpy==2.2.6 scipy==1.15.3 pandas==2.3.3 lxml==5.3.2 playwright==1.58.0 cryptography==46.0.6 aiohttp==3.13.3

COPY requirements.txt .
RUN grep -vE '^(numpy|scipy|pandas|lxml|playwright|cryptography|aiohttp|sentence-transformers|transformers)==' requirements.txt > /tmp/req.txt && \
    pip install --no-cache-dir -r /tmp/req.txt

COPY . .

# 创建数据目录
RUN mkdir -p data/chat_images data/qimg data/file/csv data/file/excel data/file/img data/file/media data/file/txt web_cookie

COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
