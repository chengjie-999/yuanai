# ===================== 密钥配置 =====================
# JWT 签名密钥（生产环境请使用随机字符串）
JWT_SECRET_KEY=change-me-to-a-random-secret

# ===================== API 密钥 =====================
# 方式一：直接设置（推荐）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DOUBAO_API_KEY=your-doubao-api-key

# 方式二：加密存储（需配合 ENCRYPTION_PASSWORD 使用）
# 先用 python -m utils.sensitive_data 生成加密值
# DEEPSEEK_API_KEY_ENCRYPTED=
# DEEPSEEK_API_KEY_SALT=
# DOUBAO_API_KEY_ENCRYPTED=
# DOUBAO_API_KEY_SALT=

# ===================== 数据库配置 =====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=ai_agent

# 方式二：加密存储
# MYSQL_PASSWORD_ENCRYPTED=
# MYSQL_PASSWORD_SALT=

# ===================== Embedding 模型（知识库向量检索） =====================
# 火山引擎 Ark 平台的 Embedding 模型 endpoint
EMBEDDING_MODEL=doubao-embedding-text-240715

# ===================== 加密密码 =====================
# 用于解密 _ENCRYPTED 类环境变量（如果使用加密存储方式）
ENCRYPTION_PASSWORD=your-encryption-password

# ===================== CORS 配置 =====================
# 允许跨域访问的来源（多个逗号分隔），生产环境请替换为你的域名
CORS_ORIGINS=https://cjyuanai.cn,https://www.cjyuanai.cn

# ===================== 本地 Agent 配置 =====================
# Agent 连接云端的 JWT 长令牌（POST /admin/agent-token 签发，或登录接口拿 7 天 token）
# 注意：JWT 的 user_id 必须等于启动时的 --agent-id
AGENT_TOKEN=

# ===================== 语音对话（火山引擎 RTC） =====================
# 开通「AI 音视频互动方案」→ 创建 RTC 应用拿 AppId/AppKey；IAM 密钥管理拿 AK/SK
# 豆包语音控制台（console.volcengine.com/speech/app）开通 ASR/TTS 拿各自 AppId + AccessToken
VOLCANO_ACCESS_KEY=
VOLCANO_SECRET_KEY=
VOLCANO_RTC_APP_ID=
VOLCANO_RTC_APP_KEY=
# 火山方舟推理接入点 ID（语音对话使用的 LLM，如 doubao-seed-2-0-lite）
VOICE_LLM_ENDPOINT_ID=
VOICE_LLM_MODEL=
VOICE_ASR_APP_ID=
VOICE_ASR_ACCESS_TOKEN=
VOICE_TTS_APP_ID=
VOICE_TTS_ACCESS_TOKEN=
# 音色 ID（豆包语音控制台可选音色，默认甜美女声）
VOICE_TTS_VOICE=zh_female_tianmei_jingpin_mars_bigtts
