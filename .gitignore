# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code (个人配置，不提交)
.claude/settings.local.json

