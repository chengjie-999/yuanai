# ===================== 密钥配置 =====================
# JWT 签名密钥（生产环境请使用随机字符串）
JWT_SECRET_KEY=change-me-to-a-random-secret

# ===================== API 密钥 =====================
# 方式一：直接设置（推荐）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DOUBAO_API_KEY=your-doubao-api-key

# 方式二：加密存储（需配合 ENCRYPTION_PASSWORD 使用）
# 先用 python -m utils.sensitive_data 生成加密值
# DEEPSEEK_API_KEY_ENCRYPTED=
# DEEPSEEK_API_KEY_SALT=
# DOUBAO_API_KEY_ENCRYPTED=
# DOUBAO_API_KEY_SALT=

# ===================== 数据库配置 =====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=ai_agent

# 方式二：加密存储
# MYSQL_PASSWORD_ENCRYPTED=
# MYSQL_PASSWORD_SALT=

# ===================== Embedding 模型（知识库向量检索） =====================
# 火山引擎 Ark 平台的 Embedding 模型 endpoint
EMBEDDING_MODEL=doubao-embedding-text-240715

# ===================== 加密密码 =====================
# 用于解密 _ENCRYPTED 类环境变量（如果使用加密存储方式）
ENCRYPTION_PASSWORD=your-encryption-password
