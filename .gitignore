# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code (个人配置，不提交)
.claude/settings.local.json

# Runtime data (运行时生成)
data/*
!data/aiprompt/
agent/data/

# OS
.DS_Store
Thumbs.db

# Environment
.env
*.env.local
# S5.1：生产环境配置不入库（模板见 deploy/.env.production.example，
# 填了真凭据的文件绝不能被 git 跟踪）
deploy/.env.production

# SSL certificates (keep .gitkeep only)
deploy/ssl/*
!deploy/ssl/.gitkeep

# Database
*.db
*.sqlite3

# Jupyter
.ipynb_checkpoints/

# Temp files
*.tmp

# PyInstaller build artifacts
build/
dist/
*.spec

# Virtual environments (besides venv/)
utils/excel_env/

# Large media files
*.mp4
*.avi
*.mkv
*.mov
*.wmv

# Excel/Office temp files
~$*.xlsx
~$*.docx

# Agent 安装包运行时产物（网页上传生成，不入库）
# downloads/ 是服务器运行时目录（上传的 exe 版本存这里、versions.json 运行时
# 改写）——整体移出 git（2026-11-16：曾被部分跟踪致 git pull 冲突风险）
downloads/
downloads/versions/

# 安装器协议页纯文本（build_agent.py 每次由 用户协议.md 生成，不入库）
docs/agreements/用户协议.txt
