FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV APP_HOME=/app

WORKDIR $APP_HOME

# apt 国内镜像加速（动态检测 Debian 版本）
RUN . /etc/os-release && \
    echo "deb http://mirrors.aliyun.com/debian $VERSION_CODENAME main contrib non-free non-free-firmware" > /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian $VERSION_CODENAME-updates main contrib non-free non-free-firmware" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian-security $VERSION_CODENAME-security main contrib non-free non-free-firmware" >> /etc/apt/sources.list

# 系统依赖：Playwright/Selenium 浏览器自动化需要的库
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# torch 依赖声明里 jinja2/typing-extensions 是小写/连字符写法，与 pytorch 索引上 wheel
# 元数据（Jinja2/typing_extensions）不一致，新版 pip 严格校验会丢弃 wheel 转去构建 sdist，
# 而 pytorch 索引不托管 flit_core 导致构建失败 → 先用清华源按精确名称预装（版本与
# requirements.txt 一致），torch 解析依赖时直接复用已安装版本
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --no-cache-dir "Jinja2==3.1.6" "typing_extensions==4.15.0" && \
    pip install --no-cache-dir torch==2.13.0+cpu --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --no-cache-dir -r requirements.txt

COPY . .

# 创建数据目录
RUN mkdir -p data/chat_images data/qimg data/file/csv data/file/excel data/file/img data/file/media data/file/txt web_cookie

COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
