# ===================== 生产环境配置 =====================
# 复制此文件为 .env 并填入真实值

# JWT 签名密钥（必须设置，长度至少 32 字符随机字符串）
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars

# API 密钥（二选一）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DOUBAO_API_KEY=your-doubao-api-key

# MySQL（Docker Compose 内用服务名 mysql）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-strong-password
MYSQL_DATABASE=ai_agent

# Redis（Docker Compose 内用服务名 redis）
REDIS_HOST=redis
REDIS_PORT=6379

# 加密密码（用于 _ENCRYPTED 类敏感数据解密，可选）
ENCRYPTION_PASSWORD=your-encryption-password

# CORS 允许的来源（ECS 公网 IP 或域名，多个逗号分隔）
CORS_ORIGINS=https://cjyuanai.cn,https://www.cjyuanai.cn
